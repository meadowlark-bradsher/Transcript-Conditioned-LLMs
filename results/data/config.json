{
  "experiment_name": "transcript_ordering_effect",
  "animals": [
    "cat",
    "dog",
    "eagle",
    "salmon",
    "shark"
  ],
  "target_pair": {
    "A": "salmon",
    "B": "shark"
  },
  "qa_triplet": [
    {
      "feature": "mammal",
      "answer": false
    },
    {
      "feature": "flies",
      "answer": false
    },
    {
      "feature": "swims",
      "answer": true
    }
  ],
  "permutations": [
    {
      "perm_id": 0,
      "indices": [
        0,
        1,
        2
      ],
      "feature_order": [
        "mammal",
        "flies",
        "swims"
      ]
    },
    {
      "perm_id": 1,
      "indices": [
        0,
        2,
        1
      ],
      "feature_order": [
        "mammal",
        "swims",
        "flies"
      ]
    },
    {
      "perm_id": 2,
      "indices": [
        1,
        0,
        2
      ],
      "feature_order": [
        "flies",
        "mammal",
        "swims"
      ]
    },
    {
      "perm_id": 3,
      "indices": [
        1,
        2,
        0
      ],
      "feature_order": [
        "flies",
        "swims",
        "mammal"
      ]
    },
    {
